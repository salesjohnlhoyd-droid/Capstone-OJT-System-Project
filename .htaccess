# Larger uploads for the OJT system (Documentary Requirements / 2x2 photo).
# Only applied when PHP runs as an Apache module; each block is skipped otherwise,
# so this file can never cause a server error. .user.ini covers PHP-FPM / CGI.
# upload_limits.php reads the values that are really in effect, so the pages
# always show the true limit.
<IfModule mod_php.c>
    php_value upload_max_filesize 15M
    php_value post_max_size 200M
    php_value max_file_uploads 50
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 15M
    php_value post_max_size 200M
    php_value max_file_uploads 50
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 15M
    php_value post_max_size 200M
    php_value max_file_uploads 50
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
